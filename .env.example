# Local Compose. Never use these sample values for a public deployment.
POSTGRES_DB=loanrun
POSTGRES_USER=loanrun
POSTGRES_PASSWORD=replace-with-local-password
# bootRun does not automatically load .env; export these or use the local profile defaults.
SPRING_PROFILES_ACTIVE=local
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/loanrun
SPRING_DATASOURCE_USERNAME=loanrun
SPRING_DATASOURCE_PASSWORD=replace-with-local-password
DEMO_MODE=true
SESSION_COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
FSS_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
# Off until the user prepares credentials/model and authorizes actual usage.
OPENAI_ENABLED=false
